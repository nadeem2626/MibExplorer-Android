<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MibExplorer.Android.ToolsPage" Title="Tools" BackgroundColor="{DynamicResource Bg}">
  <ContentPage.Resources>
    <Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource GlassCard}"/><Setter Property="Stroke" Value="{DynamicResource GlassStroke}"/><Setter Property="StrokeThickness" Value="1"/><Setter Property="Padding" Value="12"/><Setter Property="StrokeShape" Value="RoundRectangle 18"/></Style>
    <Style TargetType="Label"><Setter Property="TextColor" Value="{DynamicResource Text}"/></Style>
    <Style x:Key="H" TargetType="Label"><Setter Property="TextColor" Value="{DynamicResource Accent2}"/><Setter Property="FontAttributes" Value="Bold"/><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="{DynamicResource GlassPrimary}"/><Setter Property="TextColor" Value="{DynamicResource OnPrimary}"/><Setter Property="FontAttributes" Value="Bold"/><Setter Property="CornerRadius" Value="12"/><Setter Property="MinimumHeightRequest" Value="48"/></Style>
  </ContentPage.Resources>
  <ScrollView><VerticalStackLayout Padding="12,8" Spacing="6">
    <HorizontalStackLayout Spacing="12"><Label Text="Tools" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"/><Label x:Name="Info" TextColor="{DynamicResource Muted}" FontSize="12" VerticalOptions="Center"/></HorizontalStackLayout>
    <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start">
      <Border WidthRequest="300" MinimumHeightRequest="140" Margin="0,0,10,10" Padding="10"><VerticalStackLayout Spacing="4"><Label Text="Scripts" Style="{StaticResource H}"/><Label Text="Official and custom scripts, live output, update of the official set." FontSize="11.5" TextColor="{DynamicResource Muted}" LineBreakMode="TailTruncation" MaxLines="3"/><Button Text="Open" Clicked="OnScripts" HeightRequest="48" MinimumHeightRequest="48" Padding="10,0"/></VerticalStackLayout></Border>
      <Border WidthRequest="300" MinimumHeightRequest="140" Margin="0,0,10,10" Padding="10"><VerticalStackLayout Spacing="4"><Label Text="Terminal" Style="{StaticResource H}"/><Label Text="Shell on the unit. Needs an SSH or Telnet connection." FontSize="11.5" TextColor="{DynamicResource Muted}" LineBreakMode="TailTruncation" MaxLines="3"/><Button Text="Open" Clicked="OnTerminal" HeightRequest="48" MinimumHeightRequest="48" Padding="10,0"/></VerticalStackLayout></Border>
      <Border WidthRequest="300" MinimumHeightRequest="140" Margin="0,0,10,10" Padding="10"><VerticalStackLayout Spacing="4"><Label Text="SD packages" Style="{StaticResource H}"/><Label Text="Build the SSH installer or uninstaller package here. Works offline." FontSize="11.5" TextColor="{DynamicResource Muted}" LineBreakMode="TailTruncation" MaxLines="3"/><Button Text="Open" Clicked="OnSd" HeightRequest="48" MinimumHeightRequest="48" Padding="10,0"/></VerticalStackLayout></Border>
      <Border WidthRequest="300" MinimumHeightRequest="140" Margin="0,0,10,10" Padding="10"><VerticalStackLayout Spacing="4"><Label Text="Transfers" Style="{StaticResource H}"/><Label Text="Downloads, uploads, replaces and saves this session, with results." FontSize="11.5" TextColor="{DynamicResource Muted}" LineBreakMode="TailTruncation" MaxLines="3"/><Button Text="Open" Clicked="OnTransfers" HeightRequest="48" MinimumHeightRequest="48" Padding="10,0"/></VerticalStackLayout></Border>
      <Border x:Name="SettingsTile" WidthRequest="300" MinimumHeightRequest="140" Margin="0,0,10,10" Padding="10"><VerticalStackLayout Spacing="4"><Label Text="Settings" Style="{StaticResource H}"/><Label Text="Write mode, diagnostics, key info and app options." FontSize="11.5" TextColor="{DynamicResource Muted}" LineBreakMode="TailTruncation" MaxLines="3"/><Button Text="Open" Clicked="OnSettings" HeightRequest="48" MinimumHeightRequest="48" Padding="10,0"/></VerticalStackLayout></Border>
      <Border WidthRequest="300" MinimumHeightRequest="140" Margin="0,0,10,10" Padding="10"><VerticalStackLayout Spacing="4"><Label Text="Reboot unit" Style="{StaticResource H}"/><Label Text="Syncs, then restarts the unit. Needs SSH, Write mode, typed REBOOT." FontSize="11.5" TextColor="{DynamicResource Muted}" LineBreakMode="TailTruncation" MaxLines="3"/><Button Text="Reboot..." Clicked="OnReboot" HeightRequest="48" MinimumHeightRequest="48" Padding="10,0" Background="{DynamicResource GlassDanger}" TextColor="White"/></VerticalStackLayout></Border>
      <Border WidthRequest="300" MinimumHeightRequest="140" Margin="0,0,10,10" Padding="10"><VerticalStackLayout Spacing="4"><Label Text="Uninstall SSH" Style="{StaticResource H}"/><Label Text="Removes the SSH install. Needs SSH, Write mode, typed UNINSTALL. Reboot after." FontSize="11.5" TextColor="{DynamicResource Muted}" LineBreakMode="TailTruncation" MaxLines="3"/><Button Text="Uninstall..." Clicked="OnUninstallSsh" HeightRequest="48" MinimumHeightRequest="48" Padding="10,0" Background="{DynamicResource GlassDanger}" TextColor="White"/></VerticalStackLayout></Border>
    </FlexLayout>
  </VerticalStackLayout></ScrollView>
</ContentPage>
