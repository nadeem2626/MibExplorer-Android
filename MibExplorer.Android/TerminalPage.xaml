<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MibExplorer.Android.TerminalPage" Title="Terminal" BackgroundColor="{DynamicResource Bg}">
  <Grid RowDefinitions="Auto,*,Auto,Auto">
    <Grid ColumnDefinitions="*,Auto" Padding="8,4" ColumnSpacing="8">
      <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" VerticalOptions="Center"><Label x:Name="CrumbLabel" FontSize="13" TextColor="{DynamicResource Muted}" LineBreakMode="NoWrap"/></ScrollView>
      <HorizontalStackLayout x:Name="Actions" Grid.Column="1" Spacing="6"/>
    </Grid>
    <WebView Grid.Row="1" x:Name="Web" Navigating="OnNavigating" Navigated="OnNavigated"/>
    <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"><HorizontalStackLayout x:Name="Keys" Spacing="4" Padding="4,2"/></ScrollView>
    <Label x:Name="Info" Grid.Row="3" Padding="6" FontSize="11"/>
  </Grid>
</ContentPage>
